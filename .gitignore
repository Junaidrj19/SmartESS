# Environment and secrets
.env
.env.local
.env.*.local
*.pem

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Node / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/dist/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databases and local stores
*.db
*.sqlite
*.sqlite3
chroma/
.chroma/

# Curated corpus PDFs are obtained manually and may be copyrighted; keep the
# manifest and directory markers, but do not track the source documents.
knowledge_base/corpus/**/*.pdf
knowledge_base/fixtures/*
!knowledge_base/fixtures/.gitkeep

# Object / generated artifacts
uploads/
artifacts/
*.parquet
ml/datasets/synthetic/*/
!ml/datasets/synthetic/README.md
ml/models/*/
ml/datasets/scores/*/
ml/datasets/investigations/inv-*/
# Generated feature matrix exceeds GitHub's 100 MB file limit.
ml/datasets/features/**/*.csv

# Deployment tarball of frozen scientific artifacts (too large / local-only).
# The packer script and manifest recipe stay in Git; the archive does not.
deploy/*.tar
deploy/*.tar.gz

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
