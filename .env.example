# Application environment: development | test | production
# development and test may fall back to mock hypothesis generation when no
# provider is configured. production reads LLM credentials from the process
# environment only (a local .env file is ignored) and refuses to run if
# LLM_PROVIDER or LLM_API_KEY is missing.
APP_ENV=development

# API bind. Loopback is the default because the API has no authentication.
# Set SMARTESS_HOST only on a private interface. PORT is the listen port.
# SMARTESS_HOST=127.0.0.1
# PORT=8000

# Browser origins allowed to call the API directly. Never use *.
# The Next.js app calls the API from the server, so this list is for tools.
# SMARTESS_CORS_ORIGINS=http://127.0.0.1:3000

# Database (SQLite for MVP; PostgreSQL later)
DATABASE_URL=sqlite:///./backend/storage/smartess.db

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# LLM provider (configurable; do not commit real keys).
# The M9 hypothesis agent uses an OpenAI-compatible chat-completions endpoint.
#
# LLM_PROVIDER IS REQUIRED. If it is unset, LLMSettings.configured is False and
# create_llm_client returns MockLLMClient — the investigation still runs, but the
# hypothesis stage produces no model-generated reasoning. Set it explicitly.
LLM_PROVIDER=openrouter
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_BASE_URL=https://openrouter.ai/api/v1
# Required: bearer token, loaded from the environment. `OPENROUTER_API_KEY` is also
# honoured as a fallback source. Never put a real key in this file (`cp .env.example .env`
# and fill it there; .env is git-ignored).
LLM_API_KEY=
# Optional: per-request timeout in seconds (default 120)
LLM_TIMEOUT=180

# Embeddings and vector store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=./knowledge_base/chroma

# Paths
OBJECT_STORAGE_PATH=./backend/storage
KNOWLEDGE_BASE_PATH=./knowledge_base
