# Application
APP_ENV=development

# Database (SQLite for MVP; PostgreSQL later)
DATABASE_URL=sqlite:///./backend/storage/smartess.db

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# LLM provider (configurable; do not commit real keys)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Embeddings and vector store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=./knowledge_base/chroma

# Paths
OBJECT_STORAGE_PATH=./backend/storage
KNOWLEDGE_BASE_PATH=./knowledge_base
