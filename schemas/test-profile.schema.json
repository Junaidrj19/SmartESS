          "anyOf": [
            {
              "$ref": "#/$defs/TestConditionValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ambient_temperature_maximum": {
          "anyOf": [
            {
              "$ref": "#/$defs/TestConditionValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "thermal_control_method": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thermal Control Method"
        },
        "cooling_method": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cooling Method"
