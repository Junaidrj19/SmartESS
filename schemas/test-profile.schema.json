      "title": "TestProfileProvenance",
      "type": "object"
    },
    "TestType": {
      "enum": [
        "power_cycling",
        "HTOL",
        "HTRB",
        "HTGB",
        "custom"
      ],
      "title": "TestType",
      "type": "string"
    },
    "ThermalStress": {
      "additionalProperties": false,
      "description": "Applied thermal excursion / control setpoints.",
