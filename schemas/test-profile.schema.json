    "Unit": {
      "enum": [
        "V",
        "A",
        "mOhm",
        "Ohm",
        "uA",
        "nC",
        "C",
        "C_per_W",
        "W",
        "mm",
        "Hz"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "How a SiC module is stressed during a reliability test. References a ModuleProfile by module_profile_id. This object is not telemetry.",
  "properties": {
    "schema_version": {
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "test_id": {
      "minLength": 1,
      "title": "Test Id",
      "type": "string"
    },
    "module_profile_id": {
      "minLength": 1,
      "title": "Module Profile Id",
      "type": "string"
    },
    "test_type": {
      "$ref": "#/$defs/TestType"
    },
    "objective": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Objective"
    },
    "electrical_stress": {
      "anyOf": [
        {
          "$ref": "#/$defs/ElectricalStress"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "thermal_stress": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThermalStress"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "environmental_conditions": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvironmentalConditions"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cycle_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/CycleProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "htol_configuration": {
      "anyOf": [
        {
          "$ref": "#/$defs/HtolConfiguration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "htrb_configuration": {
      "anyOf": [
        {
          "$ref": "#/$defs/HtrbConfiguration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "htgb_configuration": {
      "anyOf": [
        {
          "$ref": "#/$defs/HtgbConfiguration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "measurement_configuration": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeasurementConfiguration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "acceptance_criteria_reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/AcceptanceCriteriaReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance": {
      "$ref": "#/$defs/TestProfileProvenance"
    }
  },
  "required": [
    "schema_version",
    "test_id",
    "module_profile_id",
    "test_type",
    "provenance"
  ],
  "title": "SiC TestProfile",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartess.dev/schemas/test-profile.schema.json"
}
