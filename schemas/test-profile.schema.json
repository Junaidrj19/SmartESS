{
  "$defs": {
    "AcceptanceCriteriaReference": {
      "additionalProperties": false,
      "description": "Which ModuleProfile acceptance criteria apply to this test. Not a duplicate of the limits.",
      "properties": {
        "parameters": {
          "items": {
            "$ref": "#/$defs/HealthParameter"
          },
          "minItems": 1,
          "title": "Parameters",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "parameters"
      ],
      "title": "AcceptanceCriteriaReference",
      "type": "object"
    },
    "CycleProfile": {
      "additionalProperties": false,
      "description": "Timing for cyclic tests such as power cycling.",
      "properties": {
        "target_cycles": {
          "minimum": 1,
          "title": "Target Cycles",
          "type": "integer"
        },
        "heating_duration_s": {
          "title": "Heating Duration S",
          "type": "number"
        },
        "cooling_duration_s": {
          "title": "Cooling Duration S",
          "type": "number"
        },
        "dwell_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dwell Time S"
        },
        "cycle_duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cycle Duration S"
        },
        "cycle_frequency_Hz": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cycle Frequency Hz"
        }
      },
      "required": [
        "target_cycles",
        "heating_duration_s",
        "cooling_duration_s"
      ],
      "title": "CycleProfile",
      "type": "object"
    },
    "ElectricalStress": {
      "additionalProperties": false,
      "description": "Applied electrical test conditions, not device ratings.",
