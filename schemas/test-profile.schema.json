        "tj_maximum": {
          "anyOf": [
            {
              "$ref": "#/$defs/TestConditionValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "delta_tj": {
          "anyOf": [
            {
              "$ref": "#/$defs/TestConditionValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
