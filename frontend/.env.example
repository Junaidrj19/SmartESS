# SmartESS Next.js frontend. Server-side only.
# Do not add NEXT_PUBLIC_* variables. Do not put API keys, LLM credentials,
# OPENROUTER_API_KEY, or LLM_API_KEY in this file or in the Vercel project.
# Those stay on the Python backend host. This app never reads them.

# --- Local development -------------------------------------------------------
# Next.js and the API on one machine. If this is unset and NODE_ENV is not
# production, the server falls back to http://127.0.0.1:8000.
# Production never uses that fallback.
SMARTESS_API_BASE_URL=http://127.0.0.1:8000

# --- Production (Vercel project environment, not this file) ------------------
# Set the deployed FastAPI origin in the Vercel project. Do not invent a host.
# Changing the value does not require a frontend code change; the server reads
# it on each request.
# SMARTESS_API_BASE_URL=https://<DEPLOYED-BACKEND-URL>

# Per-request timeout in milliseconds for the typed API client.
# Also read at request time. The investigation launch uses its own longer timeout.
SMARTESS_API_TIMEOUT_MS=10000
