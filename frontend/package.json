{
  "name": "smartess-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "SmartESS M10 \u2014 engineer-facing scientific investigation platform. Implements docs/m10/design.md and frontend/UX.md.",
  "scripts": {
    "dev": "env -u OPENROUTER_API_KEY -u LLM_API_KEY next dev",
    "build": "env -u OPENROUTER_API_KEY -u LLM_API_KEY next build",
    "start": "env -u OPENROUTER_API_KEY -u LLM_API_KEY next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "types:generate": "echo 'Requires the SmartESS API running (uvicorn backend.api.app:app). See lib/types/backend.ts header.' && exit 1"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3"
  }
}
